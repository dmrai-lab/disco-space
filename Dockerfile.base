# The Space's base image: python 3.11 with the pinned stack (requirements.txt) and the CUDA wheels' libraries on the
# loader path, no application files. Built by .github/workflows/image.yml into ghcr.io/dmrai-lab/disco-space:<sha>;
# Dockerfile.space starts FROM it, so a Space build copies files instead of installing 3 GB of wheels.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 user
ENV PATH=/home/user/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    XLA_PYTHON_CLIENT_PREALLOCATE=false \
    XLA_FLAGS=--xla_gpu_deterministic_ops=true \
    JAX_COMPILATION_CACHE_DIR=/data/jax-cache \
    JAX_PERSISTENT_CACHE_MIN_COMPILE_TIME_SECS=0.5 \
    HF_HOME=/data/hf \
    MPLCONFIGDIR=/tmp/mpl

WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir --retries 10 --timeout 60 -r /app/requirements.txt

# What the image does not use, measured (2026-09-29, 6.6 GB before): the multi-GPU libraries nccl + nvshmem (870 MB) and
# cudnn's convolution engines (precompiled / adv / cnn, 830 MB); JAX initialises and the gate reproduces its numbers
# without them. The packages' test suites (115 MB) go too.
RUN pip uninstall -y -q nvidia-nccl-cu12 nvidia-nvshmem-cu12 \
    && cd /usr/local/lib/python3.11/site-packages \
    && rm -f nvidia/cudnn/lib/libcudnn_engines_precompiled.so* nvidia/cudnn/lib/libcudnn_adv.so* nvidia/cudnn/lib/libcudnn_cnn.so* \
    && rm -rf numpy/*/tests numpy/tests scipy/*/tests scipy/tests pandas/tests matplotlib/tests dipy/*/tests

# the CUDA wheels' libraries, or the plugin falls back to the CPU silently
RUN python - <<'EOF'
import glob, os, site
libs = sorted(set(os.path.dirname(p) for sp in site.getsitepackages() for p in glob.glob(os.path.join(sp, "nvidia", "*", "lib"))))
open("/etc/ld.so.conf.d/nvidia-wheels.conf", "w").write("\n".join(libs) + "\n")
EOF
RUN ldconfig && mkdir -p /data && chown user /data
